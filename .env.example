# Copy to .env and fill every value. The API refuses to boot if any required
# value is missing, blank, or a known placeholder.

NODE_ENV=development
API_PORT=4000

# Database. The password must be at least 12 characters.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
# Must be false in production. true lets TypeORM alter the schema on boot.
DB_SYNCHRONIZE=false

# At least 32 random characters. Production tokens cannot live longer than 16h.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Comma-separated browser origins. Never use *.
CORS_ORIGINS=http://127.0.0.1:5173

# Room tax in basis points. 100 basis points = 1%. Set the rate your advisor confirms.
TAX_ROOM_BASIS_POINTS=
# Largest discount a manager may apply, in basis points.
MAX_DISCOUNT_BASIS_POINTS=

# Public self-registration is refused in production.
ALLOW_PUBLIC_REGISTER=false

# IANA time zone used for check-in and no-show dates.
PROPERTY_TIMEZONE=

# Seed is off unless you set SEED_ENABLED=true. It creates one admin and room rows.
SEED_ENABLED=false
SEED_ALLOW_PRODUCTION=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=

# Docker-only services. Required by docker compose, unused by the API.
KEYCLOAK_HOSTNAME=
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
